PORT=3001
NODE_ENV=development

# MySQL connection string. For local dev: install MySQL/MariaDB, then create a
# database and user matching this URL (see README for the exact commands).
DATABASE_URL="mysql://portfolio:portfolio_dev_pw@localhost:3306/portfolio_cms"

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Seeded admin account (used by `npm run seed`)
ADMIN_NAME=Akanksha
ADMIN_EMAIL=akanksha@example.com
ADMIN_PASSWORD=ChangeMe123!

# Seeded non-admin account, for demonstrating/testing the ADMIN vs USER
# authorization split (there is no public signup flow).
DEMO_USER_NAME=Demo Viewer
DEMO_USER_EMAIL=viewer@example.com
DEMO_USER_PASSWORD=ViewerOnly123!

# Optional: SMTP for contact-form email notifications. Leave blank to just log messages instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio Site <no-reply@portfolio.dev>"
CONTACT_NOTIFY_EMAIL=
